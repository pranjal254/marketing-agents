# LevelShift Content-to-Campaign agents — environment template
#
#   copy .env.example .env        (then fill values in .env)
#
# .env is git-ignored and must NEVER be committed or pasted into chat/tickets.
# Real environment variables always override values in this file.

# ── LLM provider ────────────────────────────────────────────────────────────
# anthropic (production) | azure_openai (dev — Azure GPT) | mock (offline; abstains)
LLM_PROVIDER=azure_openai

# Anthropic (production only)
ANTHROPIC_API_KEY=

# Azure OpenAI (dev/test provider)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=<deployment-name-e.g-gpt-4o>
AZURE_OPENAI_API_VERSION=2024-06-01

# ── Microsoft Graph (only needed for live Forms/Excel/OneDrive/Word) ───────
# Azure AD app registration, client-credential flow (IT-provisioned)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ── Telemetry / identity ────────────────────────────────────────────────────
SHIFTAI_ENVIRONMENT=dev                # dev | staging | production
SHIFTAI_TENANT_ID=levelshift-internal
# TELEMETRY_SINK_PATH=telemetry-out.jsonl
# CONTEXT_STORE_PATH=context-store.sqlite
# STS_SCHEMA_PATH=                     # optional; defaults to the starter-kit schema
