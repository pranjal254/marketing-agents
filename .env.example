# LevelShift Content-to-Campaign agents — environment template
#
#   copy .env.example .env        (then fill values in .env)
#
# .env is git-ignored and must NEVER be committed or pasted into chat/tickets.
# Real environment variables always override values in this file.

# ── LLM provider ────────────────────────────────────────────────────────────
# anthropic (production) | azure_openai (dev — Azure GPT) | mock (offline; abstains)
LLM_PROVIDER=azure_openai

# Anthropic (production only)
ANTHROPIC_API_KEY=

# Azure OpenAI (dev/test provider)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=<deployment-name-e.g-gpt-4o>
AZURE_OPENAI_API_VERSION=2024-06-01
# Contracted USD price per 1M tokens for the Azure deployment (from finance/IT).
# When set, dev telemetry costs are computed at these rates; when unset, cost is
# modeled at the production Claude rate card instead.
AZURE_OPENAI_RATE_INPUT=0.10
AZURE_OPENAI_RATE_OUTPUT=0.40

# ── Microsoft Graph (only needed for live Forms/Excel/OneDrive/Word) ───────
# Azure AD app registration, client-credential flow (IT-provisioned)
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=

# ── Context Store backend (optional) ───────────────────────────────────────
# Set → tenant-scoped Postgres (state + idempotency survive restarts; RLS,
# append-only enforced in-schema). Unset → local SQLite per bridge session.
# Requires: pip install -e "./shared[postgres]"; then apply migrations once:
#   python -m shiftai_shared.context_store.migrate
# Hosted databases: keep sslmode=require. Free-tier option: Neon.
# DATABASE_URL=postgresql://user:password@host:5432/c2c?sslmode=require

# ── SemRush (Agent 2 market/competitor intel; optional) ────────────────────
# No key → the agent runs in intel-library-only fallback mode (flagged per spec)
SEMRUSH_API_KEY=
SEMRUSH_DATABASE=us

# ── Bridge hosting (only for DEPLOYED bridges — local dev runs open) ───────
# Shared secret: when set, every /api route except /api/health requires it
# (Authorization: Bearer …, or ?token= for SSE/downloads). Set the same value
# as VITE_LIVE_TOKEN on the studio host (Vercel).
# BRIDGE_API_TOKEN=
# Allowed browser origins, comma-separated. Add any OTHER app that calls this
# bridge from a browser (an AiCoE dashboard, for instance) or the browser will
# block it. Server-to-server callers are unaffected.
# BRIDGE_CORS_ORIGINS=https://your-studio.vercel.app,https://your-dashboard.example.com

# ── Aggregated telemetry export (optional) ─────────────────────────────────
# How often POST /api/telemetry/export/refresh will actually recompute.
# Default 6. Calling sooner is not an error: the banked snapshot comes back
# with refreshed=false and a next_refresh_at.
# TELEMETRY_EXPORT_INTERVAL_HOURS=6

# ── Telemetry / identity ────────────────────────────────────────────────────
SHIFTAI_ENVIRONMENT=dev                # dev | staging | production
SHIFTAI_TENANT_ID=levelshift-internal
# TELEMETRY_SINK_PATH=telemetry-out.jsonl
# CONTEXT_STORE_PATH=context-store.sqlite
# STS_SCHEMA_PATH=                     # optional; defaults to the starter-kit schema


# .venv\Scripts\python.exe -m uvicorn c2c_bridge.app:app --port 8787